# Active production routing; DNS points at the VPS.
# Both catalog domains serve one build and one backend.
(metin2bazar_catalog) {
    root * /var/www/metin2bazar
    encode zstd gzip
    log

    @private path /admin /admin/* /backend/api/v1/admin /backend/api/v1/admin/* /api/v1/admin /api/v1/admin/*
    basicauth @private {
        {$STATS_ADMIN_USER} {$STATS_ADMIN_PASSWORD_HASH}
    }
    @admin_api path /backend/api/v1/admin /backend/api/v1/admin/* /api/v1/admin /api/v1/admin/*
    handle @admin_api {
        header X-Robots-Tag "noindex, nofollow"
        header Cache-Control "no-store"
        uri strip_prefix /backend
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Analytics-Proxy-Token {$ANALYTICS_PROXY_TOKEN}
            header_up X-Analytics-Admin {http.auth.user.id}
            header_up X-Analytics-Client-IP {remote_host}
        }
    }
    @admin_page path /admin /admin/*
    handle @admin_page {
        header X-Robots-Tag "noindex, nofollow"
        header Cache-Control "no-store"
        rewrite * /index.html
        file_server
    }

    @market_api path /backend/api/*
    handle @market_api {
        header X-Robots-Tag "noindex"
        uri strip_prefix /backend
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Analytics-Proxy-Token {$ANALYTICS_PROXY_TOKEN}
            header_up X-Analytics-Client-IP {remote_host}
            header_up -X-Analytics-Admin
        }
    }

    @pandora_market {
        path / /index.html
        query server=pandora
    }
    @elder_market {
        path / /index.html
        query server=elder
    }
    @beavium_market {
        path / /index.html
        query server=beavium
    }
    rewrite @pandora_market /server-pandora.html
    rewrite @elder_market /server-elder.html
    rewrite @beavium_market /server-beavium.html

    handle {
        file_server
    }
    handle_errors {
        @not_found expression `{http.error.status_code} == 404`
        handle @not_found {
            rewrite * /404.html
            file_server
        }
        handle {
            respond "{http.error.status_code} {http.error.status_text}"
        }
    }
}

metin2bazar.pl {
    import metin2bazar_catalog
}

www.metin2bazar.pl {
    redir https://metin2bazar.pl{uri} permanent
}

# Compatibility: accessible mirror, excluded from indexing.
metin2market.mazikox.pl {
    header X-Robots-Tag "noindex"
    @mirror_robots path /robots.txt
    handle @mirror_robots {
        header Content-Type "text/plain; charset=utf-8"
        respond "User-agent: *
Allow: /
" 200
    }
    @mirror_sitemap path /sitemap.xml
    handle @mirror_sitemap {
        respond "" 404
    }
    import metin2bazar_catalog
}

# Existing service endpoints retained for compatibility.
api.mazikox.pl {
    @private path /api/v1/admin /api/v1/admin/*
    handle @private {
        basicauth {
            {$STATS_ADMIN_USER} {$STATS_ADMIN_PASSWORD_HASH}
        }
        header Cache-Control "no-store"
        header X-Robots-Tag "noindex, nofollow"
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Analytics-Proxy-Token {$ANALYTICS_PROXY_TOKEN}
            header_up X-Analytics-Admin {http.auth.user.id}
            header_up X-Analytics-Client-IP {remote_host}
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Analytics-Proxy-Token {$ANALYTICS_PROXY_TOKEN}
            header_up X-Analytics-Client-IP {remote_host}
            header_up -X-Analytics-Admin
        }
    }
}
pandora.mazikox.pl {
    redir https://metin2market.mazikox.pl{uri} permanent
}
game.mazikox.pl {
    root * /var/www/game
    file_server
}
